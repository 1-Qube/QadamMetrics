# Copy to .env and fill in. Never commit .env.

# development | production
ENVIRONMENT=development

# SQLite is the zero-dependency local default.
# Production should use PostgreSQL, for example:
# DATABASE_URL=postgresql+psycopg://qadam:qadam@db:5432/qadammetrics
DATABASE_URL=sqlite:///./data/qadammetrics.db

# Create tables on startup. Set false in production and use Alembic.
AUTO_CREATE_TABLES=true

# Optional. When set, all /api routes require header X-API-Key.
QM_API_KEY=

# Google Gemini. The platform runs without this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Comma-separated origins, or *
CORS_ORIGINS=*

MAX_UPLOAD_MB=32
DATA_DIR=./data
LOG_LEVEL=INFO

# Set true only if you accept that logs may include row-level validation snippets.
LOG_ROW_PAYLOADS=false
